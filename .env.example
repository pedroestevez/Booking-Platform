# ── Booking Platform — environment ────────────────────────────────────────────
# Copy to `.env.local` for local dev. NEVER commit real secrets.

# ── Supabase (required) ──────────────────────────────────────────────────────
# The app reads services + availability and writes bookings through these.
# Public, browser-safe values (anon key is gated by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side ONLY. Bypasses RLS — must never be exposed to the browser or
# imported into a Client Component. Since ALI-116 this is NO LONGER the client
# for tenant-scoped reads and writes: it is reserved for the handful of
# bootstrap lookups that produce a tenant id and therefore cannot be scoped by
# one. The allow-list is a comment block in `src/lib/supabase/server.ts`.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side ONLY. **Required** — the app refuses to serve tenant data without
# it. Every tenant-scoped query carries a short-lived JWT this signs, whose
# `customer_id` claim the RLS policies read (migration 0009), so this is what
# makes row level security actually engage on the request path rather than sit
# inert behind the app's own filters. Supabase dashboard → Project Settings →
# API → JWT Settings → "JWT Secret" (the legacy HS256 signing secret; PostgREST
# verifies incoming tokens with it).
#
# There is deliberately no fallback: with this unset the app throws rather than
# quietly reverting to the RLS-bypassing service-role client, because that
# failure would be invisible — every page would still render and every test
# would still pass.
SUPABASE_JWT_SECRET=

# ── Clerk (admin dashboard auth) ─────────────────────────────────────────────
# Auth for the business-owner /admin dashboard ONLY (the customer booking flow
# is Clerk-free). Create an application at https://dashboard.clerk.com and copy
# its keys. The publishable key is browser-safe; the secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keep Clerk's hosted UI on our /admin routes:
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# ── Stripe (Connect) ─────────────────────────────────────────────────────────
# Multi-tenant payments via Stripe Connect (Express): each tenant connects their
# own account from /admin/payments; bookings are charged on the connected
# account with an optional per-tenant application fee. The platform secret key
# below creates accounts, onboarding links, and (later) connected Checkout
# sessions; the webhook secret verifies payment events.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (confirmation email) ──────────────────────────────────────────────
# Server-side ONLY — never expose to the browser or import into a Client
# Component. A confirmed booking emails the tenant's owner/admin (from
# `tenant_members`) and the guest, each with the .ics invite attached.
# Create a key at https://resend.com/api-keys. With these unset the app still
# takes bookings; it logs that email is not configured and sends nothing.
RESEND_API_KEY=
# The verified sender address. Its domain must be verified in Resend or every
# send is refused. The display name is per-tenant at send time, so configure a
# bare address here (e.g. bookings@your-verified-domain.com).
RESEND_FROM=

# ── App ──────────────────────────────────────────────────────────────────────
# Canonical origin the app is hosted at, used for absolute links + .ics invites.
NEXT_PUBLIC_APP_URL=http://localhost:3000
