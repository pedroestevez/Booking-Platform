{
  "name": "booking-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Centrally-hosted, multi-tenant booking platform for customer sites.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run && npm run test:tz",
    "test:tz": "TZ=Pacific/Kiritimati npm run test:tz:files && TZ=Europe/London npm run test:tz:files && TZ=America/New_York npm run test:tz:files",
    "test:tz:files": "vitest run src/lib/__tests__/availability.test.ts src/components/booking/__tests__/availability-calendar.test.tsx",
    "test:watch": "TZ=UTC vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:seed": "node scripts/seed-test-tenant.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.5.6",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@supabase/supabase-js": "^2.106.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.23",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.20.0",
    "stripe": "^22.2.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "pg": "^8.23.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
